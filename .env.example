# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Save it as UTF-8 (the loader also accepts the UTF-16 that PowerShell's ">" redirect writes).

# Required for /api/route/: a free key from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Optional. Development defaults are fine; for production set all three (see README, "Deploying").
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=example.com
